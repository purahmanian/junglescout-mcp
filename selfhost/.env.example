# JungleScout MCP — self-host env. Copy to selfhost/.env and fill in.
# Rotate your key first: Jungle Scout → Settings → API → Manage API Keys.
JUNGLESCOUT_API_KEY=
JUNGLESCOUT_KEY_NAME=
# Leave blank to auto-generate a bearer token on first setup run:
MCP_AUTH_TOKEN=
# Local port the server listens on (Tailscale Funnel forwards 443 → this):
PORT=3000
