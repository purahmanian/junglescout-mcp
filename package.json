{
  "name": "junglescout-mcp",
  "version": "0.1.1",
  "description": "MCP server for the Jungle Scout Cobalt/Developer API: keyword volumes, ASIN keywords, product database, sales estimates, and share of voice",
  "type": "module",
  "mcpName": "io.github.purahmanian/junglescout-mcp",
  "main": "dist/index.js",
  "bin": {
    "junglescout-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "http": "node dist/http.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jungle-scout",
    "amazon",
    "keyword-research",
    "product-research",
    "sales-estimates",
    "share-of-voice",
    "dropshipping",
    "ecommerce",
    "claude"
  ],
  "author": "Puya Rahmanian <purahmanian@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/purahmanian/junglescout-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/purahmanian/junglescout-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/purahmanian/junglescout-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@types/express": "^5.0.0"
  }
}
